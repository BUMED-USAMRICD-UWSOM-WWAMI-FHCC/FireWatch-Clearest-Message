#!/usr/bin/env python3
"""
Industrial USB Quantum Hub - KiCad 8.0 Native Layout Template Generator.
Generates a raw '.kicad_pcb' file containing structural board parameters,
a 4-layer copper configuration, and initial placement tracks for a 12-node loop.
"""

def generate_kicad8_pcb_template(filename="usb_quantum_hub_12.kicad_pcb"):
    with open(filename, 'w') as f:
        # KiCad 8.0 S-Expression Header Signature
        f.write("(pcbnew_board (version 20240108) (generator \"pcbnew\")\n")
        f.write("  (meta (generator \"KiCad\") (version \"8.0.0\"))\n\n")
        
        # 1. Industrial General Settings & Layer Stackup Setup (Heavy 2oz/3oz Copper Tracks)
        f.write("  (general\n")
        f.write("    (thickness 1.6)\n")
        f.write("  )\n\n")
        
        f.write("  (layers\n")
        f.write("    (0 \"F.Cu\" signal)\n")
        f.write("    (1 \"In1.Cu\" power)\n")
        f.write("    (2 \"In2.Cu\" ground)\n")
        f.write("    (3 \"B.Cu\" signal)\n")
        f.write("    (31 \"F.Adhes\" user \"Top Adhesive\")\n")
        f.write("    (32 \"B.Adhes\" user \"Bottom Adhesive\")\n")
        f.write("    (37 \"F.Mask\" user)\n")
        f.write("    (38 \"B.Mask\" user)\n")
        f.write("    (44 \"Edge.Cuts\" user)\n")
        f.write("  )\n\n")
        
        # 2. Design Rules & Clearance Constraints (Optimized against Fire Hazards)
        f.write("  (setup\n")
        f.write("    (pad_to_mask_clearance 0.05)\n")
        f.write("    (pcb_text_width 0.15)\n")
        f.write("    (pcb_text_size 1.0 1.0)\n")
        f.write("    (track_width 0.50)       ; Thick 2oz/3oz power trace routing default\n")
        f.write("    (min_track_width 0.25)\n")
        f.write("    (clearance 0.30)         ; Increased isolation space to eliminate short-circuit fire risks\n")
        f.write("  )\n\n")
        
        # 3. Component Positioning Loops (Placing the Hub's Hardware Footprints)
        # Main Power Input Barrel Jack 2.1mm / 5.5mm
        f.write("  (footprint \"Connector_BarrelJack:BarrelJack_Horizontal\"\n")
        f.write("    (at 10.0 50.0 0)\n")
        f.write("    (layer \"F.Cu\")\n")
        f.write("    (property \"Reference\" \"J_PWR1\" (at 10.0 45.0 0) (layer \"F.SilkS\")\n")
        f.write("      (effects (font (size 1 1) (thickness 0.15))))\n")
        f.write("  )\n\n")
        
        # Positioning for the 12 Inline Standard-Colored USB-B Receptacles
        # Placed incrementally down the bus channel at 15mm steps
        for i in range(1, 13):
            x_pos = 25.0 + (i * 15.0)
            y_pos = 50.0
            f.write(f"  (footprint \"Connector_USB:USB_B_Female_Horizontal\"\n")
            f.write(f"    (at {x_pos} {y_pos} 0)\n")
            f.write(f"    (layer \"F.Cu\")\n")
            f.write(f"    (property \"Reference\" \"J{i}\" (at {x_pos} {y_pos - 5.0} 0) (layer \"F.SilkS\")\n")
            f.write(f"      (effects (font (size 1 1) (thickness 0.15))))\n")
            f.write(f"  )\n\n")
            
        # 4. Outlining Structural 3D-Case Boundary Lines (Edge.Cuts Layer Profile)
        f.write("  (gr_rect (start 5.0 35.0) (end 215.0 65.0) (layer \"Edge.Cuts\") (width 0.1) (tstamp \"board_bounds\"))\n\n")
        
        f.write(")\n")
    print(f"[SUCCESS] Native KiCad 8.0 Layout Template compiled into structural board file: '{filename}'")

if __name__ == "__main__":
    generate_kicad8_pcb_template()
